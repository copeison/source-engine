top = '.'
PROJECT_NAME = 'fgdlib'

def options(opt):
	return

def configure(conf):
	return

def build(bld):
	source = [
		'gamedata.cpp',
		'gdclass.cpp',
		'gdvar.cpp',
		'inputoutput.cpp',
		'wckeyvalues.cpp',
	]

	includes = [
		'.',
		'../public',
		'../public/tier0',
		'../public/tier1',
		'../utils/common',
	]

	bld.stlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		defines  = [],
		use      = ['tier0', 'tier1'],
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx      = bld.get_taskgen_count()
	)
