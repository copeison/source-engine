#! /usr/bin/env python
# encoding: utf-8

top = '.'
PROJECT_NAME = 'lzma'

def options(opt):
	return

def configure(conf):
	return

def build(bld):
	# LzmaDec.c is already compiled into tier1 (without _LZMA_PROB32), so it is
	# left out here and _LZMA_PROB32 is not defined: CLzmaDec's layout depends
	# on it, and lzma.cpp must agree with tier1's decoder.
	source = [
		'lzma.cpp',
		'C/LzmaEnc.c',
		'C/LzFind.c',
	]

	includes = [
		'.',
		'C',
		'../../public',
		'../../public/tier0',
		'../../public/tier1',
	]

	bld.stlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		defines  = ['_NO_EXCEPTIONS', '_7ZIP_ST'],
		use      = ['tier0', 'tier1'],
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx      = bld.get_taskgen_count()
	)
